a:3:{s:4:"data";a:13:{s:2:"id";i:21;s:5:"title";s:6:"手打";s:7:"excerpt";s:0:"";s:7:"content";s:1816:"[code lang="javascript"]
function initCodeEditors() {
    if (document.getElementById('content_editor')) {
        const contentTextarea = document.getElementById('content');
        window.contentEditor = CodeMirror(document.getElementById('content_editor'), {
            value: contentTextarea.value,
            mode: 'htmlmixed',
            theme: 'dracula',
            lineNumbers: true,
            autoCloseTags: true,
            lineWrapping: true,
            height: '400px',
            extraKeys: {
                'Ctrl-S': function(cm) {
                    const form = document.querySelector('form');
                    if(form) form.dispatchEvent(new Event('submit'));
                },
                // 修复回车键换两行的问题 - 保留智能缩进但只换一行
                'Enter': function(cm) {
                    // 获取当前光标位置和当前行内容
                    const cursor = cm.getCursor();
                    const line = cm.getLine(cursor.line);
                    const indent = line.match(/^(\s*)/)[0]; // 获取当前行的缩进
                    
                    // 执行智能缩进但只插入一个换行符
                    cm.replaceSelection('\n' + indent);
                    
                    // 将光标移动到新行的正确位置
                    const newCursor = {line: cursor.line + 1, ch: indent.length};
                    cm.setCursor(newCursor);
                }
            }
        });
        window.contentEditor.on('change', function() {
            contentTextarea.value = window.contentEditor.getValue();
            const inputEvent = new Event('input', { bubbles: true });
            contentTextarea.dispatchEvent(inputEvent);
        });
    }
[/code]";s:4:"date";s:10:"2026-01-14";s:4:"tags";a:1:{i:0;s:3:"程";}s:10:"word_count";i:180;s:9:"read_time";i:1;s:10:"created_at";s:19:"2026-01-31 21:29:44";s:10:"updated_at";s:19:"2026-02-02 19:57:18";s:10:"created_by";N;s:6:"author";s:0:"";s:12:"author_email";N;}s:6:"expire";i:1770193384;s:7:"created";i:1770189784;}